# ── PostgreSQL (local) ──────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/milaap

# ── Qdrant Cloud ────────────────────────────────────────────────────────────
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key

# ── Vercel Blob ─────────────────────────────────────────────────────────────
VERCEL_BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# ── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-secret-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── Resend Email ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_api_key_here
